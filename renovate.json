{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "terraform": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Terraform provider bumps",
      "matchDatasources": ["terraform-provider"],
      "groupName": "terraform providers"
    },
    {
      "description": "Group registry module bumps",
      "matchDatasources": ["terraform-module"],
      "groupName": "terraform modules"
    },
    {
      "description": "Helm chart versions pinned in variables/locals are tracked via regex managers",
      "matchManagers": ["regex"],
      "groupName": "helm charts"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Helm chart versions declared as `default = \"x.y.z\" # renovate: chart=<repo>/<chart>`",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*#\\s*renovate:\\s*chart=(?<depName>[^\\s]+)\\s+registryUrl=(?<registryUrl>[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
